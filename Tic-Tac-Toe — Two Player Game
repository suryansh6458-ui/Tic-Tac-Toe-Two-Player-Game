
# Tic-Tac-Toe - Two Player Game

board = [
    ["1", "2", "3"],
    ["4", "5", "6"],
    ["7", "8", "9"]
]

winning_combinations = [
    [(0, 0), (0, 1), (0, 2)],
    [(1, 0), (1, 1), (1, 2)],
    [(2, 0), (2, 1), (2, 2)],

    [(0, 0), (1, 0), (2, 0)],
    [(0, 1), (1, 1), (2, 1)],
    [(0, 2), (1, 2), (2, 2)],

    [(0, 0), (1, 1), (2, 2)],
    [(0, 2), (1, 1), (2, 0)]
]

player = "X"
moves = 0
game_over = False

print("=" * 35)
print("       TIC-TAC-TOE GAME")
print("=" * 35)

while game_over == False:

    # Display the board
    print()

    for row in board:
        print(" | ".join(row))
        print("-" * 11)

    print("\nPlayer", player, "'s turn")

    try:
        position = int(
            input("Enter position (1-9): ")
        )

        if position < 1 or position > 9:
            print("Invalid position! Choose 1 to 9.")
            continue

        row = (position - 1) // 3
        column = (position - 1) % 3

        if board[row][column] == "X" or \
           board[row][column] == "O":

            print("Position already occupied!")
            continue

        # Place player's symbol
        board[row][column] = player
        moves += 1

        # Check winning combinations
        winner = False

        for combination in winning_combinations:

            first = combination[0]
            second = combination[1]
            third = combination[2]

            if (
                board[first[0]][first[1]] ==
                board[second[0]][second[1]] ==
                board[third[0]][third[1]]
            ):
                winner = True

        if winner:
            print("\nFinal Board:")

            for row in board:
                print(" | ".join(row))
                print("-" * 11)

            print("\nPlayer", player, "wins!")
            game_over = True

        elif moves == 9:
            print("\nFinal Board:")

            for row in board:
                print(" | ".join(row))
                print("-" * 11)

            print("\nGame Draw!")
            game_over = True

        else:
            # Switch player
            if player == "X":
                player = "O"
            else:
                player = "X"

    except ValueError:
        print("Please enter a valid number.")

print("\nThanks for playing!")
